# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SEPAY_API_KEY: Optional SePay API Key for transaction verification
SEPAY_API_KEY=

# SEPAY_WEBHOOK_SECRET: Optional SePay webhook secret for payload signature verification
SEPAY_WEBHOOK_SECRET=

# DATABASE_URL: Optional Postgres/Supabase connection string.
# Defaults to file-backed JSON store in data/database.json if not set.
DATABASE_URL=

# ADMIN_PASSCODE: Passcode to access the Admin Management Dashboard.
# Defaults to "aitienphong" if not specified.
ADMIN_PASSCODE=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Chuỗi bí mật dùng chung với website U48MMO (tối thiểu 32 ký tự).
U48_PROVISION_SECRET=
